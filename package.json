{
  "name": "eventbase-automation",
  "version": "1.0.0",
  "description": "EventBase — Full Playwright Automation Suite with Allure Reporting",
  "author": "Arbaaz Hussain",
  "scripts": {
    "test": "npx playwright test",
    "test:login": "npx playwright test tests/login/",
    "test:signup": "npx playwright test tests/signup/",
    "test:events": "npx playwright test tests/events/",
    "test:booking": "npx playwright test tests/booking/",
    "test:manager": "npx playwright test tests/manager/",
    "test:navigation": "npx playwright test tests/navigation/",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:html": "npx playwright show-report reports/html-report",
    "clean": "rm -rf allure-results allure-report reports screenshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0"
  }
}
